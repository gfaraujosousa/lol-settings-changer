{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "LoL Settings Changer",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.lolsettingschanger.app",
      "icon": [
        "icons/icon.ico"
      ],
      "targets": [
        "nsis"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "LoL Settings Changer",
        "width": 860,
        "height": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
