{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "LoL Settings Changer",
    "version": "0.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      },
      "shell": {
        "open": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": [
          "https://api.github.com/**",
          "https://github.com/gfaraujosousa/lol-settings-changer/**",
          "https://objects.githubusercontent.com/**",
          "https://release-assets.githubusercontent.com/**"
        ]
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.lolsettingschanger.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": [
        "nsis"
      ]
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/tray-32.png",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "title": "LoL Settings Changer",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
